# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Meta / Facebook app (developers.facebook.com → your app) ----
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business → Configurations → "WhatsApp Embedded Signup" configuration ID
NEXT_PUBLIC_META_CONFIG_ID=
META_GRAPH_VERSION=v23.0

# Any random text. Paste the same text in Meta → WhatsApp → Configuration → Webhook "Verify token"
WHATSAPP_VERIFY_TOKEN=wasil-oman-verify

# Protects the scheduled-broadcast cron endpoint (Vercel sends it automatically as a Bearer token)
CRON_SECRET=
